{
  "name": "homepact",
  "version": "0.1.0",
  "private": true,
  "description": "Client–constructor contract agreement for a house purchase (monorepo).",
  "packageManager": "npm@10.9.9",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @homepact/shared",
    "build:api": "npm run build -w @homepact/api",
    "build:web": "npm run build -w @homepact/web",
    "test": "npm run test --workspaces --if-present",
    "test:shared": "npm run test -w @homepact/shared",
    "test:api": "npm run test -w @homepact/api",
    "test:web": "npm run test -w @homepact/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "qa": "npm install --no-audit --no-fund && npm run check",
    "dev": "node scripts/stack.mjs --dev",
    "start": "node scripts/stack.mjs",
    "dev:api": "npm run dev -w @homepact/api",
    "dev:web": "npm run dev -w @homepact/web",
    "e2e:install": "playwright install chromium",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "minimatch": "^10.2.6 || ^11.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.7": true
  }
}

{
  "name": "@homepact/web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "build:shared": "npm run build -w @homepact/shared",
    "predev": "npm run build:shared",
    "dev": "ng serve --port ${WEB_PORT:-4200}",
    "prebuild": "npm run build:shared",
    "build": "ng build",
    "prewatch": "npm run build:shared",
    "watch": "ng build --watch --configuration development",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check:templates": "node scripts/check-templates.mjs",
    "i18n:extract": "ng extract-i18n",
    "pretest": "npm run build:shared",
    "test": "node scripts/check-templates.mjs && ng test --watch=false"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@homepact/shared": "0.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/localize": "^22.2.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}

{
  "name": "@homepact/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build:shared": "npm run build -w @homepact/shared",
    "predev": "npm run build:shared",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "prebuild": "npm run build:shared",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build:shared",
    "test": "vitest run",
    "preseed:super-admin": "npm run build:shared",
    "seed:super-admin": "node --env-file-if-exists=../../.env --import tsx src/scripts/seed-super-admin.ts",
    "preseed:showcase": "npm run build:shared",
    "seed:showcase": "node --env-file-if-exists=../../.env --import tsx src/scripts/seed-showcase.ts"
  },
  "dependencies": {
    "@homepact/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.13",
    "mongodb": "^7.7.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}

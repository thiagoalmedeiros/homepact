NODE_ENV=development
COMPOSE_PROJECT_NAME=homepact

API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
PLATFORM_ADMIN_ORIGIN=http://localhost:4300
JWT_SECRET=change-me-to-a-long-random-string-0123456789
LOG_LEVEL=info

WEB_PORT=4200
ADMIN_PORT=4300

SEED_SHOWCASE=true
SEED_ADMIN_EMAIL=admin@platform.demo
SEED_ADMIN_PASSWORD=Showcase2026!
SEED_DEMO_PASSWORD=Showcase2026!
SHOWCASE_ORIGINS=http://localhost:4200
SECOND_TENANT_ORIGINS=http://127.0.0.1:4200

# npm run dev / npm start run their own database (no Docker): mongod, or the in-memory JavaScript
# database where mongod cannot be downloaded or started. DB_ENGINE=memory or mongod picks one.
# The data is gone on exit unless MONGO_DATA_DIR names a folder to keep it in.
# DB_ENGINE=memory
# MONGO_DATA_DIR=data/mongo

# Only for a MongoDB you run yourself (npm run dev:mongo -w apps/api, seed:*) or the Docker stack.
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_DB_NAME=homepact
MONGO_URI=mongodb://root:change-me@localhost:27017/homepact?authSource=admin

# Copy to .env (cp .env.example .env). Never commit .env.
# All values below are local-development placeholders.

# API
API_PORT=3000
LOG_LEVEL=info

# Web
WEB_PORT=4200

# MongoDB
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=homepact
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_DB_NAME=homepact
# Used when the API runs on your machine (npm run dev:api). Docker Compose overrides the host.
MONGO_URI=mongodb://homepact:change-me@localhost:27017/homepact?authSource=admin
